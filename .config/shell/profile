#!/bin/zsh

# Profile file. Runs on login. Environmental variables are set here.

# -L: stow links subdirectories like statusbar/ as symlinks.
typeset -U path
path=(${(f)"$(find -L ~/.local/bin -type d 2>/dev/null)"} ~/.cargo/bin ~/go/bin ${KREW_ROOT:-$HOME/.krew}/bin $path)
export PATH

# Default programs:
export EDITOR="nvim"
export VISUAL="nvim"
export TERMINAL="alacritty"
export TERMINAL_PROG="alacritty"
export BROWSER="brave"

# Other important variables:

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export ZDOTDIR="$HOME/.config/zsh"
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME="qt6ct"
export AWS_CONFIG_FILE="$HOME/.config/aws/config"
export GOPATH="$HOME/go"

# File with system-specific settings. Generated per machine by autoinstall.sh
# and gitignored -- keep machine-specific values here, never in tracked configs.
export SYSTEM_PROFILE="$ZDOTDIR/.local"

if [[ -f "$SYSTEM_PROFILE" ]]; then
    source "$SYSTEM_PROFILE"
fi
