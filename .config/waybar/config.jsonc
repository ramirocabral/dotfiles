{
  // Per-host modules: local.jsonc (gitignored) defines "group/local". Missing
  // file or group just hides it. See local.jsonc.example.
  "include": ["~/.config/waybar/local.jsonc"],

  "layer": "top",
  "position": "bottom",
  "height": 20,
  "spacing": 0,

  "modules-left": [
    "sway/workspaces",
  ],
  "modules-center": [],
  "modules-right": [
    "network",
    "custom/nmvpn",
    // "sway/language",
    "custom/kb_layout",
    "pulseaudio",
    "battery",
    "memory",
    "custom/cputemp",
    "cpu",
    "clock",
    "custom/wallpaper",
    "group/local",
    "tray"
  ],

  "custom/wallpaper": {
    "format": "{}",
    "return-type": "json",
    "exec": "wpm waybar",
    "interval": "once",
    "signal": 8,
    "on-click": "wpm gui",
    "on-click-right": "wpm fav -q",
    "on-click-middle": "wpm ban -q",
    "on-scroll-up": "wpm next -q",
    "on-scroll-down": "wpm prev -q",
  },

  "sway/workspaces": {
    "enable-bar-scroll": true,
    "disable-scroll-wraparound": true,
  },

  "network": {
    "interval": 1,
    "format": "{ifname} @ {ipaddr}/{cidr}   {bandwidthDownBits}  {bandwidthUpBits}",
    "format-wifi": "{essid} @ {ipaddr}/{cidr}   {bandwidthDownBits}  {bandwidthUpBits}",
    "format-disconnected": " Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}"
  },
  "custom/nmvpn": {
    "format": "{} {icon}",
    "return-type": "json",
    "exec": "$HOME/.local/bin/statusbar/nmvpn",
    "format-icons": {
        "connected": "",
        "disconnected": "",
        "none": "",
        "error": "⚠"
    }
  },
  //
  // "sway/language": {
  //   "format": " {}",
  //   "interval": 1,
  // },

  "custom/kb_layout": {
    "exec": "$HOME/.local/bin/statusbar/kb_layout",
    "interval": "once",
    "signal": 10,
    "format": "  {}",
    // "on-click": "togglelayout"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 MUTE",
    "format-icons": {
      "default": ["", "", ""]
    },
    "scroll-step": 5
  },

  // Hidden on machines without a battery.
  "battery": {
    // Full and "not charging" fall back to "format".
    "format": "  {capacity}%",
    "format-charging": "  {capacity}% ",
    "format-discharging": "  {capacity}% "
  },

  "memory": {
    "interval": 2,
    "format": " {used:0.1f}/{total:0.1f} GiB",
    "states": {
      "normal": 0,
      "warning": 70,
      "critical": 85
    }
  },

  "custom/cputemp": {
    "format": " {}°C",
    "return-type": "json",
    "exec": "$HOME/.local/bin/statusbar/cputemp --waybar",
    "interval": 2
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%"
  },

  "clock": {
    "format": "{:%a %d-%m-%Y %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "timezone": "America/Argentina/Buenos_Aires",
    "interval": 50
  },

  "tray": {
    "spacing": 10
  }
}
