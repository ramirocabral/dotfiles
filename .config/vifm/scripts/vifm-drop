#!/bin/sh
# Opens a dragon-drop target; files dropped on it are copied (moved with -m) into $1, URLs are downloaded.

op="cp -r"
[ "$1" = -m ] && { op="mv"; shift; }
dest=${1:-.}

dragon-drop --target --and-exit --print-path | while IFS= read -r item; do
    case $item in
        http://* | https://*) curl -fsSL --output-dir "$dest" -OJ -- "$item" ;;
        *) $op -n -- "$item" "$dest"/ ;;
    esac
done
