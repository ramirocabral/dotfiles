.config/doublecmd/*

!.config/doublecmd/doublecmd.xml
!.config/doublecmd/doublecmd.cfg
!.config/doublecmd/colors.json
!.config/doublecmd/shortcuts.scf
!.config/doublecmd/pixmaps.txt

.config/zsh/.zcompdump

# Machine-specific config: generated or hand-written per host, never tracked.
# Ship a .example alongside anything added here.
.config/sway/monitor.conf
.config/zsh/.local
.config/waybar/local.jsonc

# Generated by packer.nvim on :PackerCompile; contains absolute paths.
.config/nvim/plugin/packer_compiled.lua

# Python bytecode, written next to any script that gets imported.
__pycache__/

# Claude Code instructions are local, not part of the published repo.
CLAUDE.md

# LibreOffice lock files
.~lock.*#

# pipx entrypoint symlinks. ~/.local/bin is stowed from this repo, so pipx
# writes them here; they point at absolute venv paths and would dangle on
# another machine. Install the packages via progs.csv instead.
.local/bin/wpm
.local/bin/claude-swap
.local/bin/cswap
