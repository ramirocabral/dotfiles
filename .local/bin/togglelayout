#!/bin/sh

# Toggles the keyboard layout between us and es, under sway or X (i3), and
# refreshes the bar's layout block.

current_layout=$("$(dirname "$0")/statusbar/kb_layout")

if [ "$current_layout" = "US" ]; then
    new_layout="es"
else
    new_layout="us"
fi

if [ -n "$SWAYSOCK" ]; then
    swaymsg input type:keyboard xkb_layout "$new_layout"
    pkill -SIGRTMIN+10 waybar
else
    # setxkbmap keeps the current options (caps:swapescape) when only -layout is given
    setxkbmap -layout "$new_layout"
    pkill -SIGRTMIN+10 i3blocks
fi
