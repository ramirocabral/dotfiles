#!/bin/sh

# Prints the active keyboard layout as US or ES, under sway or X (i3).

if [ -n "$SWAYSOCK" ]; then
    # xkb_active_layout_name is the long name, e.g. "English (US)" or "Spanish"
    layout=$(swaymsg -t get_inputs | grep -m 1 -E 'xkb_active_layout_name' | awk '{print $2}' | tr -d '"')
    [ "$layout" = "English" ] && layout=us
else
    layout=$(setxkbmap -query | awk '/^layout:/ {print $2}')
fi

if [ "$layout" = "us" ]; then
    echo "US"
else
    echo "ES"
fi
