#!/bin/zsh

# receives the file with the packets number
update(){
    # take the file name
    cache=/tmp/${1##*/}    
    # if the file does not exist, we create it and set old to 0
    read -r sum < $1
    [ -f $cache ] && read -r old < "$cache"  || old=0
    printf "%d\n" "$sum" > "$cache"
    echo $(( sum - old ))
}

iface=$("${0:h}/egress-iface")
[ -n "$iface" ] || { echo "Rx: 0 Tx: 0"; exit 0; }

rx=$(update /sys/class/net/"$iface"/statistics/rx_bytes)
tx=$(update /sys/class/net/"$iface"/statistics/tx_bytes)

echo "Rx: $(numfmt --to=si $rx) Tx: $(numfmt --to=si $tx)"
