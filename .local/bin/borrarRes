#!/bin/sh

#$1 = directorio pasado en el parametro,en el que borraran los archivos residuales:
#los que no tienen extension, los .o y los .class

error() {
    echo "Error: $1" >&2
    exit 1
}

if [ $# -ne 1 ]; then
    error 'ingrese un directorio a limpiar'
fi


if [ ! -d "$1" ]; then
    error "no existe el directorio $1"
fi

for path in "$1"/*; do
    [ -f "$path" ] || continue
    file=${path##*/}
    case "$file" in
        *.o|*.class) ;;
        *.*) continue ;;
    esac
    echo "Removido $file"
    rm "$path"
done

exit 0
