#!/bin/sh

# Relink the dotfiles after every pull. Most of the repo is linked as whole
# directories, so new files inside them show up on their own, but a new entry
# under a directory that is real in $HOME (.config, .local/bin,
# .local/share/applications) needs stow to run again. -R also drops the links to files the pull removed.
#
# No --adopt: a conflict is reported and left alone, never resolved by moving
# the local file over the tracked one. Stow aborts the whole run on a conflict,
# so until it is fixed nothing else gets linked either.
#
# Enabled per clone with: git config core.hooksPath .githooks

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! out="$(stow -R -t "$HOME" . 2>&1)"; then
    printf '\n\033[1;31mpost-merge: stow failed, dotfiles were NOT relinked\033[0m\n%s\n' "$out" >&2
    printf 'Fix the conflicts above, then run: stow -R -t ~ .\n\n' >&2
fi

# Only what this pull added: every machine skips some packages on purpose in the installer.
missing() {
    git diff ORIG_HEAD HEAD -- progs.csv | sed -n "s/^+$1,\([^,]*\).*/\1/p" | xargs -r pacman -T
}

if command -v pacman >/dev/null 2>&1 && git rev-parse -q --verify ORIG_HEAD >/dev/null; then
    pkgs="$(missing p | paste -sd ' ' -)"
    aur="$(missing a | paste -sd ' ' -)"
    if [ -n "$pkgs$aur" ]; then
        printf '\n\033[1;33mpost-merge: new programs in progs.csv are not installed here\033[0m\n' >&2
        [ -n "$pkgs" ] && printf '  sudo pacman -S --needed %s\n' "$pkgs" >&2
        [ -n "$aur" ] && printf '  paru -S --needed %s\n' "$aur" >&2
        echo >&2
    fi
fi
